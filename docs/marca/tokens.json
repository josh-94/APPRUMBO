{
  "$description": "RUMBO design tokens v2.0 (direccion verde, formato W3C Design Tokens / Style Dictionary v4). Fuente de verdad: docs/marca/manual-de-marca.md",
  "rumbo": {
    "color": {
      "primary": {
        "$type": "color",
        "default": { "$value": "#066B49", "$description": "Verde Rumbo" },
        "hover": { "$value": "#055B3E" },
        "strong": { "$value": "#04432F", "$description": "Verde Profundo" },
        "soft": { "$value": "#DBF1E4", "$description": "Verde Bruma" },
        "on": { "$value": "#FFFFFF" }
      },
      "secondary": {
        "$type": "color",
        "default": { "$value": "#17F296", "$description": "Verde Impulso" },
        "hover": { "$value": "#0CC97D", "$description": "Verde Brote" },
        "soft": { "$value": "#D9FBEC" },
        "on": { "$value": "#06321F" }
      },
      "semantic": {
        "$type": "color",
        "income": { "$value": "#066B49", "$description": "Verde Rumbo" },
        "income-soft": { "$value": "#DBF1E4" },
        "expense": { "$value": "#8E3A9E", "$description": "Ciruela" },
        "expense-soft": { "$value": "#F1E2F4" },
        "alert": { "$value": "#B3261E", "$description": "Rojo Alto" },
        "alert-soft": { "$value": "#FBE4E2" },
        "success": { "$value": "#17F296", "$description": "Verde Impulso (relleno)" },
        "success-text": { "$value": "#05543A" },
        "success-soft": { "$value": "#D9FBEC" },
        "info": { "$value": "#3C5FB8", "$description": "Azul Horizonte" },
        "info-light": { "$value": "#7BA0E6", "$description": "Azul Horizonte claro: graficos e ilustracion" },
        "info-soft": { "$value": "#E4EBFA" }
      },
      "neutral": {
        "$type": "color",
        "bg": { "$value": "#F4F9F2", "$description": "Lino Verde" },
        "surface": { "$value": "#FFFFFF", "$description": "Papel" },
        "surface-strong": { "$value": "#2A3932", "$description": "Noche Bosque" },
        "on-strong": { "$value": "#FFFFFF" },
        "on-strong-muted": { "$value": "#A9B8B0", "$description": "Bruma" },
        "ink": { "$value": "#1A2620", "$description": "Tinta Bosque" },
        "ink-secondary": { "$value": "#5A6B62", "$description": "Pizarra" },
        "ink-muted": { "$value": "#83938B", "$description": "Niebla, solo texto >= 24px" },
        "border": { "$value": "#E3ECE4", "$description": "Linea" },
        "disabled": { "$value": "#B6C3BA" },
        "disabled-bg": { "$value": "#EDF3EE" },
        "track": { "$value": "#E3ECE4" },
        "track-on-strong": { "$value": "#3E5048" }
      }
    },
    "color-dark": {
      "primary": {
        "$type": "color",
        "default": { "$value": "#22E79A" },
        "hover": { "$value": "#4EEFB0" },
        "strong": { "$value": "#4EEFB0" },
        "soft": { "$value": "#0B3A28" },
        "on": { "$value": "#06231A" }
      },
      "secondary": {
        "$type": "color",
        "default": { "$value": "#17F296" },
        "hover": { "$value": "#56F7B4" },
        "soft": { "$value": "#123B2B" },
        "on": { "$value": "#06321F" }
      },
      "semantic": {
        "$type": "color",
        "income": { "$value": "#3DD68C" },
        "income-soft": { "$value": "#0F3326" },
        "expense": { "$value": "#C98BE0" },
        "expense-soft": { "$value": "#331F3B" },
        "alert": { "$value": "#FF6B5E" },
        "alert-soft": { "$value": "#44191A" },
        "success": { "$value": "#17F296" },
        "success-text": { "$value": "#8CF7C8" },
        "success-soft": { "$value": "#123B2B" },
        "info": { "$value": "#8FAEF2" },
        "info-light": { "$value": "#7BA0E6" },
        "info-soft": { "$value": "#1A2740" }
      },
      "neutral": {
        "$type": "color",
        "bg": { "$value": "#0D140F" },
        "surface": { "$value": "#141D17" },
        "surface-strong": { "$value": "#1E2A23" },
        "on-strong": { "$value": "#FFFFFF" },
        "on-strong-muted": { "$value": "#B8C6BE" },
        "ink": { "$value": "#EDF4EE" },
        "ink-secondary": { "$value": "#A9B8B0" },
        "ink-muted": { "$value": "#83938B" },
        "border": { "$value": "#2A3932" },
        "disabled": { "$value": "#4E5C54" },
        "disabled-bg": { "$value": "#1F2A24" },
        "track": { "$value": "#2A3932" },
        "track-on-strong": { "$value": "#35443C" }
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": { "$value": ["Bricolage Grotesque", "Inter", "system-ui", "sans-serif"] },
        "text": { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 },
        "semibold": { "$value": 600 },
        "bold": { "$value": 700 },
        "extrabold": { "$value": 800 }
      }
    },
    "typography": {
      "$type": "typography",
      "display": { "$value": { "fontFamily": "{rumbo.font.family.text}", "fontSize": "40px", "fontWeight": 700, "lineHeight": 1.0, "letterSpacing": "-0.03em" }, "$description": "Montos heroe y numero del anillo (Inter tnum)" },
      "h1": { "$value": { "fontFamily": "{rumbo.font.family.display}", "fontSize": "30px", "fontWeight": 800, "lineHeight": 1.1, "letterSpacing": "-0.03em" } },
      "h2": { "$value": { "fontFamily": "{rumbo.font.family.display}", "fontSize": "24px", "fontWeight": 700, "lineHeight": 1.15, "letterSpacing": "-0.03em" } },
      "h3": { "$value": { "fontFamily": "{rumbo.font.family.display}", "fontSize": "19px", "fontWeight": 700, "lineHeight": 1.25, "letterSpacing": "-0.015em" } },
      "body": { "$value": { "fontFamily": "{rumbo.font.family.text}", "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.45, "letterSpacing": "0em" } },
      "body-strong": { "$value": { "fontFamily": "{rumbo.font.family.text}", "fontSize": "15px", "fontWeight": 600, "lineHeight": 1.45, "letterSpacing": "0em" } },
      "small": { "$value": { "fontFamily": "{rumbo.font.family.text}", "fontSize": "13.5px", "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0em" } },
      "label": { "$value": { "fontFamily": "{rumbo.font.family.text}", "fontSize": "11.5px", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "0.08em" }, "$description": "Siempre en mayusculas" }
    },
    "space": {
      "$type": "dimension",
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "5": { "$value": "20px" },
      "6": { "$value": "24px" },
      "8": { "$value": "32px" },
      "10": { "$value": "40px" },
      "12": { "$value": "48px" },
      "screen-padding": { "$value": "20px" }
    },
    "radius": {
      "$type": "dimension",
      "xs": { "$value": "10px" },
      "sm": { "$value": "12px" },
      "md": { "$value": "14px" },
      "lg": { "$value": "18px" },
      "card": { "$value": "20px" },
      "pill": { "$value": "999px" }
    },
    "border-width": {
      "$type": "dimension",
      "default": { "$value": "1px" },
      "strong": { "$value": "1.5px" }
    },
    "shadow": {
      "$type": "shadow",
      "sm": { "$value": { "color": "#1A26200F", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
      "md": { "$value": [
        { "color": "#1A26200D", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px" },
        { "color": "#1A26202E", "offsetX": "0px", "offsetY": "14px", "blur": "30px", "spread": "-16px" }
      ] },
      "lg": { "$value": [
        { "color": "#1A26201A", "offsetX": "0px", "offsetY": "6px", "blur": "16px", "spread": "0px" },
        { "color": "#1A262059", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-20px" }
      ] }
    },
    "icon": {
      "size": {
        "$type": "dimension",
        "sm": { "$value": "18px" },
        "md": { "$value": "22px" },
        "lg": { "$value": "28px" }
      },
      "stroke": { "$type": "number", "$value": 1.75 }
    },
    "duration": {
      "$type": "duration",
      "instant": { "$value": "120ms" },
      "fast": { "$value": "200ms" },
      "base": { "$value": "320ms" },
      "slow": { "$value": "600ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$value": [0.3, 0, 0, 1.2] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    },
    "component": {
      "tabbar": {
        "bg": { "$type": "color", "$value": "{rumbo.color.neutral.surface-strong}" },
        "icon": { "$type": "color", "$value": "{rumbo.color.neutral.on-strong-muted}" },
        "height": { "$type": "dimension", "$value": "64px" },
        "inset": { "$type": "dimension", "$value": "16px" },
        "radius": { "$type": "dimension", "$value": "{rumbo.radius.pill}" },
        "shadow": { "$type": "shadow", "$value": "{rumbo.shadow.lg}" }
      },
      "tab-active": {
        "bg": { "$type": "color", "$value": "{rumbo.color.secondary.default}" },
        "fg": { "$type": "color", "$value": "{rumbo.color.secondary.on}" },
        "height": { "$type": "dimension", "$value": "48px" }
      },
      "summary-card": {
        "bg": { "$type": "color", "$value": "{rumbo.color.neutral.surface-strong}" },
        "fg": { "$type": "color", "$value": "{rumbo.color.neutral.on-strong}" },
        "fg-muted": { "$type": "color", "$value": "{rumbo.color.neutral.on-strong-muted}" },
        "label": { "$type": "color", "$value": "{rumbo.color.secondary.default}" },
        "radius": { "$type": "dimension", "$value": "{rumbo.radius.card}" }
      },
      "progress-ring": {
        "size": { "$type": "dimension", "$value": "120px" },
        "stroke": { "$type": "dimension", "$value": "12px" },
        "progress": { "$type": "color", "$value": "{rumbo.color.secondary.default}" },
        "track": { "$type": "color", "$value": "{rumbo.color.neutral.track-on-strong}" }
      },
      "week-chip": {
        "bg": { "$type": "color", "$value": "{rumbo.color.neutral.bg}" },
        "done-bg": { "$type": "color", "$value": "{rumbo.color.primary.soft}" },
        "done-fg": { "$type": "color", "$value": "{rumbo.color.primary.strong}" },
        "today-border": { "$type": "color", "$value": "{rumbo.color.primary.default}" },
        "radius": { "$type": "dimension", "$value": "{rumbo.radius.md}" }
      },
      "quick-card": {
        "bg": { "$type": "color", "$value": "{rumbo.color.neutral.surface}" },
        "radius": { "$type": "dimension", "$value": "{rumbo.radius.card}" },
        "icon-circle": { "$type": "dimension", "$value": "40px" }
      },
      "greeting-pill": {
        "bg": { "$type": "color", "$value": "{rumbo.color.neutral.surface}" },
        "height": { "$type": "dimension", "$value": "44px" },
        "radius": { "$type": "dimension", "$value": "{rumbo.radius.pill}" }
      }
    }
  }
}
