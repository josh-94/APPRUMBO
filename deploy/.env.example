SESSION_SECRET=cambia-este-secreto-largo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# En el servidor: https://mi.apprumbo.online/api/auth/google/callback y COOKIE_SECURE=true
GOOGLE_REDIRECT_URL=http://127.0.0.1:8088/api/auth/google/callback
DATABASE_URL=postgres://hoy:hoy@postgres:5432/hoy?sslmode=disable
POSTGRES_PASSWORD=hoy
REDIS_URL=redis://redis:6379/0
APP_TIMEZONE=America/Bogota
COOKIE_SECURE=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@codewithjosh.codes
TUNNEL_TOKEN=
OLLAMA_URL=http://ollama:11434
# Solo texto (sin visión). Vacío = no se usa modelo VL.
OLLAMA_MODEL=
OLLAMA_TEXT_MODEL=qwen2.5:3b
# Núcleos físicos de la placa (no hiperthreads).
OLLAMA_NUM_THREAD=4
# Groq (gratis con límites). Si hay key, drafts van a Groq; si falla, Ollama.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Vacío = sin Whisper (audio desactivado).
WHISPER_URL=
HOY_API_IMAGE=hoy-api:local
HOY_WORKER_IMAGE=hoy-worker:local
HOY_WEB_IMAGE=hoy-web:local
